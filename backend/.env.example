# Add these to the Render Web Service environment. Never put them in Vite variables.
GEMINI_API_KEY=replace_with_server_secret
AI_MODEL=gemini-3.1-flash-lite
RESEND_API_KEY=replace_with_server_secret
RESEND_FROM=leads@notify.hybridcontrol.co.za
ALLOWED_ORIGINS=https://hybridcontrol.co.za,https://www.hybridcontrol.co.za
# Render sets PORT automatically; use 3001 for local development.
PORT=3001
