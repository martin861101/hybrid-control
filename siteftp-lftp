#!/usr/bin/env python3
"""Interactive FTPS site archive / static-folder deployment tool. Python 3.10+; stdlib only."""
from __future__ import annotations

import argparse
import datetime as dt
import fnmatch
import ftplib
import getpass
import json
import os
from pathlib import Path
import posixpath
import re
import ssl
import shutil
import subprocess
import sys
import uuid

CONFIG = Path.home() / ".config" / "siteftp" / "profiles.json"
PROTECTED_REMOTE = {".well-known", ".ftpquota", ".siteftp"}
EXCLUDE_DIRS = {".git", ".svn", ".hg", "node_modules", ".venv", "venv", "__pycache__", ".next", "backend", "src"}
EXCLUDE_FILES = {".env", "id_rsa", "id_ed25519", ".DS_Store", "Thumbs.db"}
EXCLUDE_GLOBS = (".env.*", "*.pem", "*.key", "*.p12", "*.pfx", "*.sqlite", "*.sqlite3", "*.db", "*.log")


def fail(message: str) -> None:
    raise ValueError(message)


def ask(message: str, default: str = "") -> str:
    hint = f" [{default}]" if default else ""
    answer = input(f"{message}{hint}: ").strip()
    return answer or default


def yes_no(message: str, default: bool = False) -> bool:
    suffix = "Y/n" if default else "y/N"
    answer = input(f"{message} [{suffix}]: ").strip().lower()
    if not answer:
        return default
    return answer in ("y", "yes")


def require_phrase(phrase: str, message: str) -> bool:
    return input(f"{message}\nType {phrase} to continue: ").strip() == phrase


def safe_segment(value: str) -> str:
    if not value or value in (".", "..") or "/" in value or "\\" in value or any(ord(c) < 32 for c in value):
        fail("Backup folder must be a single safe directory name.")
    return value


def clean_remote(value: str, allow_root: bool = False) -> str:
    value = value.strip().replace("\\", "/")
    if not value:
        fail("Remote path must not be blank.")
    if any(part == ".." for part in value.split("/")) or any(ord(c) < 32 for c in value):
        fail("Remote path cannot contain '..' or control characters.")
    path = posixpath.normpath("/" + value.lstrip("/"))
    if path == "/" and not allow_root:
        fail("Remote / is blocked. Set a specific document-root path, such as /public_html.")
    return path


def remote_join(base: str, name: str) -> str:
    return posixpath.join(base, name)


def load_profiles() -> dict:
    try:
        return json.loads(CONFIG.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (ValueError, OSError):
        print("Warning: cannot read saved profiles; proceeding without them.", file=sys.stderr)
        return {}


def save_profiles(profiles: dict) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(CONFIG.parent, 0o700)
    data = json.dumps(profiles, indent=2, sort_keys=True) + "\n"
    # Only non-secret connection settings. Never save passwords.
    fd = os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.write(data)
    os.chmod(CONFIG, 0o600)


def select_site() -> tuple[str, dict]:
    profiles = load_profiles()
    names = sorted(profiles)
    if names:
        print("\nSaved sites:")
        for i, name in enumerate(names, 1):
            p = profiles[name]
            print(f"  {i}. {name} ({p['host']} → {p['webroot']})")
    print(f"  {len(names) + 1}. Add / enter another site")
    choice = ask("Choose site", str(len(names) + 1))
    if choice.isdigit() and 1 <= int(choice) <= len(names):
        name = names[int(choice) - 1]
        return name, profiles[name]
    if choice != str(len(names) + 1):
        fail("Invalid site selection.")
    name = ask("Site profile name (e.g. hybrid)")
    if not name:
        fail("Site name required.")
    host = ask("FTP hostname (not a URL)")
    if not host or "/" in host or any(c.isspace() for c in host):
        fail("Use a bare hostname, such as ftp.example.com.")
    port = int(ask("FTP port", "21"))
    if not 1 <= port <= 65535:
        fail("Invalid FTP port.")
    user = ask("FTP username")
    if not user:
        fail("FTP username required.")
    webroot = clean_remote(ask("Remote website folder", "/public_html"), allow_root=True)
    p = {"host": host, "port": port, "user": user, "webroot": webroot}
    if yes_no("Save this site's non-secret settings for next time?", True):
        profiles[name] = p
        save_profiles(profiles)
    return name, p


def connect(site: dict, insecure: bool) -> ftplib.FTP:
    password = getpass.getpass(f"FTP password for {site['user']}@{site['host']}: ")
    if insecure:
        print("WARNING: Plain FTP exposes credentials and files in transit.")
        ftp: ftplib.FTP = ftplib.FTP(timeout=30)
    else:
        ctx = ssl.create_default_context()
        ftp = ftplib.FTP_TLS(context=ctx, timeout=30)
    try:
        ftp.connect(site["host"], site["port"])
        ftp.login(site["user"], password)
        if isinstance(ftp, ftplib.FTP_TLS):
            ftp.prot_p()
        ftp.voidcmd("TYPE I")
        ftp.cwd(site["webroot"])
        ftp.cwd("/")
        return ftp
    except Exception:
        try:
            ftp.close()
        except Exception:
            pass
        raise
    finally:
        password = ""  # Never persisted to disk or included in logs.


def remote_entries(ftp: ftplib.FTP, path: str) -> dict[str, dict]:
    """MLSD where supported; NLST fallback for simpler hosting FTP servers."""
    try:
        result = {}
        for name, facts in ftp.mlsd(path, facts=["type", "size", "modify"]):
            if name in (".", "..") or facts.get("type") in ("cdir", "pdir"):
                continue
            if "/" in name or "\\" in name:
                fail(f"Unsafe remote filename received: {name!r}")
            result[name] = facts
        return result
    except (ftplib.error_perm, ftplib.error_reply, ftplib.error_proto, AttributeError):
        pass
    # Some hosts don't implement MLSD. NLST + cwd/SIZE/MDTM is slower but works.
    try:
        names = ftp.nlst(path)
    except ftplib.error_perm as exc:
        if str(exc).startswith("550"):
            return {}
        raise
    results = {}
    original = ftp.pwd()
    for item in names:
        name = posixpath.basename(item.rstrip("/"))
        if name in ("", ".", ".."):
            continue
        full = remote_join(path, name)
        try:
            ftp.cwd(full)
            results[name] = {"type": "dir"}
        except ftplib.error_perm:
            facts = {"type": "file"}
            try:
                size = ftp.size(full)
                if size is not None:
                    facts["size"] = str(size)
            except ftplib.all_errors:
                pass
            try:
                response = ftp.sendcmd(f"MDTM {full}")
                match = re.search(r"(\d{14})", response)
                if match:
                    facts["modify"] = match.group(1)
            except ftplib.all_errors:
                pass
            results[name] = facts
        finally:
            ftp.cwd(original)
    return results


def is_dir(facts: dict) -> bool:
    return facts.get("type", "").lower() in ("dir", "os.unix=dir")


def excluded(rel: Path) -> bool:
    for part in rel.parts:
        if part in EXCLUDE_DIRS or part in EXCLUDE_FILES or any(fnmatch.fnmatch(part, glob) for glob in EXCLUDE_GLOBS):
            return True
    return False


def local_files(source: Path) -> dict[str, Path]:
    output = {}
    for base, dirs, files in os.walk(source, followlinks=False):
        current = Path(base)
        dirs[:] = sorted(d for d in dirs if not excluded((current / d).relative_to(source)) and not (current / d).is_symlink())
        for name in sorted(files):
            path = current / name
            rel = path.relative_to(source)
            if excluded(rel) or path.is_symlink() or not path.is_file():
                continue
            output[rel.as_posix()] = path
    return output


def select_source(cwd: Path) -> Path:
    candidates = [p for p in cwd.iterdir() if p.is_dir() and not p.is_symlink() and not excluded(Path(p.name))]
    candidates.sort(key=lambda p: (p.name not in ("dist", "build", "html", "public_html", "www"), p.name.casefold()))
    print(f"\nLocal sync location (inside {cwd}):")
    for i, p in enumerate(candidates, 1):
        print(f"  {i}. {p.name}/")
    root_choice = len(candidates) + 1
    custom_choice = root_choice + 1
    print(f"  {root_choice}. Current directory ./ (advanced)")
    print(f"  {custom_choice}. Enter a relative folder path")
    choice = ask("Select source", "1" if candidates else str(root_choice))
    if not choice.isdigit():
        fail("Enter a numbered option.")
    number = int(choice)
    if 1 <= number <= len(candidates):
        source = candidates[number - 1]
    elif number == root_choice:
        source = cwd
        print("WARNING: Publishing the project root can expose source code. Known secrets and source directories are excluded, but this is not a security audit.")
        if not require_phrase("ROOT", "Only select this for a directory containing PUBLIC website files."):
            fail("Current-directory sync cancelled.")
    elif number == custom_choice:
        relative = ask("Relative folder inside current directory (e.g. website/dist)")
        raw = Path(relative)
        if raw.is_absolute() or ".." in raw.parts:
            fail("Source must be a subfolder of the current directory.")
        source = (cwd / raw).resolve(strict=True)
        if source == cwd or cwd not in source.parents:
            fail("Choose a subfolder within your current working directory.")
    else:
        fail("Invalid source selection.")
    if not source.is_dir() or source.is_symlink():
        fail("Source must be a real directory.")
    return source


def parse_timestamp(value: str | None) -> float | None:
    if not value:
        return None
    try:
        return dt.datetime.strptime(value[:14], "%Y%m%d%H%M%S").replace(tzinfo=dt.timezone.utc).timestamp()
    except ValueError:
        return None


def needs_upload(path: Path, facts: dict | None, force: bool) -> bool:
    if force or facts is None or is_dir(facts):
        return True
    try:
        if path.stat().st_size != int(facts["size"]):
            return True
    except (KeyError, TypeError, ValueError):
        return True
    stamp = parse_timestamp(facts.get("modify"))
    # If same-sized contents were edited since last upload, upload them again.
    # With no server timestamp, treat same-size as uncertain and upload.
    return stamp is None or path.stat().st_mtime > stamp + 1


def ensure_remote_dir(ftp: ftplib.FTP, path: str) -> None:
    parts = path.strip("/").split("/") if path != "/" else []
    cursor = "/"
    for part in parts:
        cursor = remote_join(cursor, part)
        try:
            ftp.mkd(cursor)
        except ftplib.error_perm:
            try:
                original = ftp.pwd()
                ftp.cwd(cursor)
                ftp.cwd(original)
            except ftplib.all_errors:
                raise RuntimeError(f"Cannot create/access remote folder: {cursor}") from None


def upload_atomic(ftp: ftplib.FTP, local: Path, remote: str, exists: bool) -> None:
    parent = posixpath.dirname(remote)
    name = posixpath.basename(remote)
    tag = uuid.uuid4().hex[:10]
    stage = remote_join(parent, f".siteftp-upload-{tag}-{name}")
    previous = remote_join(parent, f".siteftp-prev-{tag}-{name}")
    with local.open("rb") as stream:
        ftp.storbinary(f"STOR {stage}", stream, blocksize=1024 * 256)
    moved_old = False
    try:
        if exists:
            ftp.rename(remote, previous)
            moved_old = True
        ftp.rename(stage, remote)
        if moved_old:
            ftp.delete(previous)
    except Exception:
        if moved_old:
            try:
                ftp.rename(previous, remote)
            except Exception:
                print(f"CRITICAL: recover the old file manually from {previous}", file=sys.stderr)
        try:
            ftp.delete(stage)
        except Exception:
            pass
        raise


def remote_files_for_sync(ftp: ftplib.FTP, root: str, source: Path, relative: str = "") -> dict[str, dict]:
    path = remote_join(root, relative) if relative else root
    entries = remote_entries(ftp, path)
    return {remote_join(relative, name) if relative else name: facts for name, facts in entries.items()}


def delete_unmatched(ftp: ftplib.FTP, path: str, keep: set[str], rel: str = "") -> int:
    count = 0
    for name, facts in sorted(remote_entries(ftp, path).items()):
        if name in PROTECTED_REMOTE or name.startswith(".siteftp-"):
            continue
        child_rel = f"{rel}/{name}" if rel else name
        if child_rel in keep or any(k.startswith(child_rel + "/") for k in keep):
            if is_dir(facts):
                count += delete_unmatched(ftp, remote_join(path, name), keep, child_rel)
            continue
        full = remote_join(path, name)
        if is_dir(facts):
            count += remove_remote_tree(ftp, full)
            ftp.rmd(full)
        else:
            ftp.delete(full)
        count += 1
        print(f"  DELETE {child_rel}")
    return count


def remove_remote_tree(ftp: ftplib.FTP, path: str) -> int:
    count = 0
    for name, facts in remote_entries(ftp, path).items():
        full = remote_join(path, name)
        if is_dir(facts):
            count += remove_remote_tree(ftp, full)
            ftp.rmd(full)
        else:
            ftp.delete(full)
        count += 1
    return count


def sync_site_lftp(site: dict, args: argparse.Namespace) -> None:
    """Reverse-mirror with lftp; server-side directory discovery/creation is delegated to lftp."""
    if shutil.which("lftp") is None:
        fail("lftp is required. Install with: sudo apt install lftp")

    source = select_source(Path.cwd())
    if source == Path.cwd():
        fail("Sync of project root is disabled for safety. Choose dist/, html/, or another public folder.")
    if args.force:
        fail("--force is not supported by the lftp sync. Use normal sync (changed files are uploaded).")
    files = local_files(source)
    if not files:
        fail(f"No publishable files found in {source}; refusing to sync.")
    if not any(key in files for key in ("index.html", "index.htm")):
        if not yes_no("No index.html found. Continue with this source?"):
            return
    # Mirror uploads ALL files in the selected folder, not just `local_files`.
    # Refuse a source containing symlinks or known secret files rather than silently publishing them.
    for base, dirs, filenames in os.walk(source, followlinks=False):
        for name in dirs + filenames:
            path = Path(base) / name
            if path.is_symlink():
                fail(f"Symlink in publish folder; inspect/remove before syncing: {path}")
            if excluded(path.relative_to(source)):
                fail(f"Non-public file or folder in selected source; inspect before syncing: {path}")

    target = site["webroot"].rstrip("/") + "/"
    print(f"\nSource: {source}/\nTarget: {target}\nLocal files: {len(files)}")
    print("Remote-only files will be preserved: NO --delete option will be used.")
    if not args.dry_run and not require_phrase("SYNC", "Proceed with lftp reverse mirror?"):
        print("Cancelled.")
        return

    # Reproduce the exact lftp mirror workflow that already works on this hosting server.
    # Never insert user-controlled strings as unquoted commands.
    def quoted(value: str) -> str:
        return "'" + value.replace("'", "'\\''") + "'"

    password = getpass.getpass(f"FTP password for {site['user']}@{site['host']}: ")
    if args.insecure_ftp:
        print("WARNING: Plain FTP transmits the password and files without encryption.")
    ftp_settings = "set ftp:ssl-allow no; " if args.insecure_ftp else "set ftp:ssl-force yes; set ftp:ssl-protect-data yes; "
    flags = "--reverse --verbose --dry-run" if args.dry_run else "--reverse --verbose"
    script = (
        "set cmd:fail-exit yes; "
        + ftp_settings
        + "set ftp:list-options -a; "
        + f"mirror {flags} {quoted(str(source) + '/')} {quoted(target)}; "
        + "bye"
    )
    url = f"ftp://{site['host']}:{site['port']}"
    try:
        # The successful Wine & Chapters deployment used `lftp -u ... -e mirror ...`.
        # Credentials are not stored; note that -u briefly exposes them to local process listings.
        subprocess.run(["lftp", "-u", f"{site['user']},{password}", url, "-e", script], check=True)
    except subprocess.CalledProcessError as exc:
        fail(f"lftp failed (exit {exc.returncode}). No remote-only files were intentionally deleted.")
    finally:
        password = ""
    print("DRY RUN complete; no files uploaded." if args.dry_run else "Sync complete. Verify the live site.")


def remote_is_dir(ftp: ftplib.FTP, path: str) -> bool:
    """Ask the server directly: some FTP hosts return unreliable MLSD type facts."""
    previous = ftp.pwd()
    try:
        ftp.cwd(path)
        return True
    except ftplib.error_perm as exc:
        if str(exc).startswith("550"):
            return False
        raise
    finally:
        ftp.cwd(previous)


def move_archive_entry(ftp: ftplib.FTP, src: str, dst: str, facts: dict) -> int:
    """Archive individual files. NEVER call RNFR/RNTO on a directory.

    Resume by merging existing destination directories without overwriting files.
    The returned count is individual file moves, for meaningful partial progress.
    """
    parent = posixpath.dirname(dst)
    basename = posixpath.basename(dst)
    destination = remote_entries(ftp, parent)
    src_is_dir = remote_is_dir(ftp, src)
    if src_is_dir:
        if basename in destination:
            if not remote_is_dir(ftp, dst):
                fail(f"Archive conflict: destination is not a directory: {dst}. Nothing overwritten.")
        else:
            try:
                ftp.mkd(dst)
            except ftplib.error_perm as exc:
                # A concurrent or earlier partial run may have made it already.
                if not remote_is_dir(ftp, dst):
                    raise RuntimeError(f"Cannot create archive directory {dst}: {exc}") from exc
        moved = 0
        for name, child_facts in sorted(remote_entries(ftp, src).items()):
            moved += move_archive_entry(ftp, remote_join(src, name), remote_join(dst, name), child_facts)
        # Never remove a source directory unless all children are gone.
        remaining = remote_entries(ftp, src)
        if remaining:
            fail(f"Source directory still has entries; refusing to remove it: {src}")
        ftp.rmd(src)
        print(f"  Directory complete: {src}", flush=True)
        return moved

    if basename in destination:
        fail(f"Archive conflict: destination file already exists: {dst}. Nothing overwritten.")
    # Only files are renamed. This works on hosts rejecting directory RNFR/RNTO.
    try:
        ftp.rename(src, dst)
    except ftplib.all_errors as exc:
        raise RuntimeError(f"Cannot move FILE {src} to {dst}: {exc}") from exc
    print(f"  Moved file: {src} -> {dst}", flush=True)
    return 1


def archive_site(ftp: ftplib.FTP, site_name: str, webroot: str, args: argparse.Namespace) -> None:
    if webroot == "/":
        fail("Cannot archive: FTP account is rooted at /. Need access to the PARENT of public_html to create a sibling backup.")
    parent = posixpath.dirname(webroot)
    backup_default = re.sub(r"[^a-zA-Z0-9_-]+", "-", site_name).strip("-").lower() + ".old"
    backup_name = safe_segment(ask("Backup folder name (alongside public_html)", backup_default))
    backup = remote_join(parent, backup_name)
    existing = remote_entries(ftp, parent)
    resume = False
    if backup_name in existing:
        if not remote_is_dir(ftp, backup):
            fail(f"Backup path is not a directory: {backup}")
        print(f"Backup folder already exists: {backup}")
        if yes_no("Resume a PARTIAL archive into this exact folder? (do not use for an unrelated older backup)"):
            resume = True
            if not args.dry_run and not require_phrase("RESUME", f"WARNING: Merge remaining source entries into {backup}. Existing files will not be overwritten."):
                print("Cancelled.")
                return
        else:
            fail("Cancelled. Choose the EXACT existing partial backup and answer YES to resume; no automatic suffix will be added.")
    items = sorted(remote_entries(ftp, webroot).items())
    if not items:
        print(f"{webroot} is empty; nothing to archive.")
        return
    print(f"\nARCHIVE PLAN\n  From: {webroot}\n  To:   {backup}\n  Entries remaining: {len(items)} (files and whole subfolders)")
    for name, _ in items[:40]:
        print("  MOVE", name)
    if len(items) > 40:
        print(f"  ... and {len(items) - 40} more")
    print("WARNING: The website may go offline until you deploy the replacement. Moving .well-known could affect certificate challenges.")
    if args.dry_run:
        print("DRY RUN: no remote directory created and no items moved.")
        return
    if not require_phrase("ARCHIVE", "These remote items will be moved server-side, not copied."):
        print("Cancelled.")
        return
    if not resume:
        ftp.mkd(backup)
    moved_entries = 0
    moved_files = 0
    try:
        for name, facts in items:
            moved_files += move_archive_entry(ftp, remote_join(webroot, name), remote_join(backup, name), facts)
            moved_entries += 1
            print(f"[{moved_entries}/{len(items)}] Completed {name}; files moved this run: {moved_files}", flush=True)
    except Exception:
        print(f"PARTIAL ARCHIVE: completed {moved_entries}/{len(items)} top-level entries; moved {moved_files} files. Backup: {backup}. Inspect both directories and resume using this EXACT backup name.", file=sys.stderr)
        raise
    remaining = remote_entries(ftp, webroot)
    if remaining:
        fail(f"Archive did not empty {webroot}; remaining: {', '.join(sorted(remaining))}. Inspect before syncing.")
    print(f"Archive complete: {backup} ({moved_files} files moved this run).\nOriginal website folder remains ready for a new sync.")


def main() -> int:
    parser = argparse.ArgumentParser(description="Interactive Linux FTP/FTPS static website sync")
    parser.add_argument("--dry-run", action="store_true", help="Preview without uploading or moving files")
    parser.add_argument("--force", action="store_true", help="Upload all selected files regardless of remote size/time")
    parser.add_argument("--insecure-ftp", action="store_true", help="Use unencrypted FTP only when FTPS is unavailable")
    args = parser.parse_args()
    print("\nSITEFTP | Reusable website archive & sync\n")
    site_name, site = select_site()
    print("\nOperations:\n  1. Archive current remote site into sibling .old folder\n  2. Sync a folder from the CURRENT local directory to the website")
    operation = ask("Choose operation", "2")
    if operation not in ("1", "2"):
        fail("Invalid operation.")
    if site["webroot"] == "/" and operation == "2":
        print("WARNING: This account's FTP root is your webroot. Sync from / is allowed, but remote deletion is disabled.")
        if not require_phrase("WEBROOT", "Confirm that the FTP root contains ONLY your website files."):
            return 0
    if operation == "1":
        fail("Archive is disabled in this version: this FTP server times out moving WordPress directories. Existing partial backups are untouched. Use hosting file manager or a verified local download for backup.")
    sync_site_lftp(site, args)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)
    except (ValueError, OSError, ftplib.Error, ssl.SSLError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)
